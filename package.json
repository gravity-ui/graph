{
  "name": "@gravity-ui/graph-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "Monorepo for Gravity UI Graph packages and applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/graph"
  },
  "scripts": {
    "typecheck": "pnpm run build && pnpm --filter \"./packages/*\" --filter \"./apps/*\" run typecheck",
    "lint": "pnpm --filter \"./packages/*\" run lint && pnpm --filter @gravity-ui/graph-storybook run lint",
    "test:unit": "pnpm --filter \"./packages/*\" run test:unit",
    "test": "pnpm --filter \"./packages/*\" run test",
    "storybook": "pnpm run build && pnpm --filter @gravity-ui/graph-storybook run storybook",
    "build-storybook": "pnpm run build && pnpm --filter @gravity-ui/graph-storybook run build-storybook",
    "build:docs": "pnpm --filter @gravity-ui/graph run build:docs",
    "build": "pnpm --filter @gravity-ui/graph --filter @gravity-ui/graph-react --filter @gravity-ui/graph-minimap --filter @gravity-ui/graph-devtools --filter @gravity-ui/graph-duplicate-block --filter @gravity-ui/graph-layered --filter @gravity-ui/graph-playwright --filter @gravity-ui/graph-css-variables --filter @gravity-ui/graph-elk --filter @gravity-ui/graph-connection-editing run build",
    "dev": "chokidar \"packages/*/src/**/*\" \"scripts/build-package.mjs\" -c \"pnpm run build\" --initial",
    "e2e:bundle": "pnpm --filter @gravity-ui/graph-e2e run e2e:bundle",
    "e2e:serve": "pnpm --filter @gravity-ui/graph-e2e run e2e:serve",
    "e2e:build": "pnpm --filter @gravity-ui/graph-e2e run e2e:build",
    "test:e2e": "pnpm --filter @gravity-ui/graph-e2e run test:e2e",
    "test:e2e:ui": "pnpm --filter @gravity-ui/graph-e2e run test:e2e:ui",
    "test:e2e:debug": "pnpm --filter @gravity-ui/graph-e2e run test:e2e:debug",
    "test:e2e:ci": "pnpm --filter @gravity-ui/graph-e2e run test:e2e:ci",
    "test:package-contract": "node scripts/package-contract/run.mjs",
    "bench:culling": "node scripts/bench/culling/run.mjs",
    "e2e:dev": "pnpm --filter @gravity-ui/graph-e2e run e2e:dev",
    "test:type-configs": "node --test scripts/css-assets.test.mjs scripts/style-observer-types.test.mjs scripts/tsconfig-strict.test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@gravity-ui/graph": "workspace:*",
    "@gravity-ui/prettier-config": "^1.1.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^20.17.0",
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.27.2",
    "prettier": "^3.0.0",
    "publint": "^0.3.23",
    "release-please": "17.6.0",
    "typescript": "catalog:",
    "yaml": "2.8.1"
  }
}
