{
  "name": "@gravity-ui/graph-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "Monorepo for Gravity UI Graph packages and applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/graph"
  },
  "scripts": {
    "typecheck": "pnpm --filter @gravity-ui/graph run typecheck",
    "typecheck:published-playwright-types": "pnpm --filter @gravity-ui/graph run typecheck:published-playwright-types",
    "lint": "pnpm --filter @gravity-ui/graph run lint",
    "test:unit": "pnpm --filter @gravity-ui/graph run test:unit",
    "test": "pnpm --filter @gravity-ui/graph run test",
    "storybook": "pnpm --filter @gravity-ui/graph run storybook",
    "storybook:build": "pnpm --filter @gravity-ui/graph run storybook:build",
    "build-storybook": "pnpm --filter @gravity-ui/graph run build-storybook",
    "ci:storybook:build": "pnpm --filter @gravity-ui/graph run ci:storybook:build",
    "build:docs": "pnpm --filter @gravity-ui/graph run build:docs",
    "copy-styles": "pnpm --filter @gravity-ui/graph run copy-styles",
    "build:playwright-runtime": "pnpm --filter @gravity-ui/graph run build:playwright-runtime",
    "build:publish": "pnpm --filter @gravity-ui/graph run build:publish",
    "build": "pnpm --filter @gravity-ui/graph run build",
    "dev": "pnpm --filter @gravity-ui/graph run dev",
    "e2e:bundle": "pnpm --filter @gravity-ui/graph run e2e:bundle",
    "e2e:serve": "pnpm --filter @gravity-ui/graph run e2e:serve",
    "e2e:build": "pnpm --filter @gravity-ui/graph run e2e:build",
    "test:e2e": "pnpm --filter @gravity-ui/graph run test:e2e",
    "test:e2e:ui": "pnpm --filter @gravity-ui/graph run test:e2e:ui",
    "test:e2e:debug": "pnpm --filter @gravity-ui/graph run test:e2e:debug",
    "test:e2e:ci": "pnpm --filter @gravity-ui/graph run test:e2e:ci",
    "test:package-contract": "pnpm --filter @gravity-ui/graph run test:package-contract",
    "e2e:dev": "pnpm --filter @gravity-ui/graph run e2e:dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@gravity-ui/prettier-config": "^1.1.0",
    "prettier": "^3.0.0"
  }
}
