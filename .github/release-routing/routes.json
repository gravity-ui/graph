{
  "activePhase": "pre-cutover",
  "branchCreationPolicy": "skip-release-job",
  "releaseRoutes": {
    "pre-cutover-v1": {
      "phase": "pre-cutover",
      "branch": "main",
      "major": 1,
      "prerelease": false,
      "distTag": "latest",
      "workflow": "release-v1.yml",
      "active": true
    },
    "pre-cutover-v2": {
      "phase": "pre-cutover",
      "branch": "v2",
      "major": 2,
      "prerelease": true,
      "distTag": "next",
      "workflow": "release-v2.yml",
      "active": true
    },
    "post-cutover-v1": {
      "phase": "post-cutover",
      "branch": "release/v1",
      "major": 1,
      "prerelease": false,
      "distTag": "v1",
      "workflow": "release-v1.yml",
      "active": false
    },
    "post-cutover-v2": {
      "phase": "post-cutover",
      "branch": "main",
      "major": 2,
      "prerelease": false,
      "distTag": "latest",
      "workflow": "release-v2.yml",
      "active": false
    }
  },
  "previewRoutes": {
    "main": {
      "workflow": "main-preview.yml",
      "destination": "/graph/main/"
    },
    "v2": {
      "workflow": "v2-preview.yml",
      "destination": "/graph/v2/"
    }
  }
}
