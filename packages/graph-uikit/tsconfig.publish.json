{
  "extends": "./tsconfig",
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    // @gravity-ui/uikit declarations import `react-beautiful-dnd` types that uikit ships only as a devDependency (TS7016).
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-utils/**"
  ]
}
