{
  "compilerOptions": {
    "outDir": "./build/",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2020",
    "noEmitOnError": true,
    "allowJs": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": [
      "es2020",
      "dom",
      "dom.iterable"
    ],
    "noUncheckedSideEffectImports": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "./src/**/*.ts"
  ]
}
