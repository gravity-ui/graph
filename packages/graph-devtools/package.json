{
  "name": "@gravity-ui/graph-devtools",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "Rulers and crosshair debugging tools for Gravity UI Graph",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/graph",
    "directory": "packages/graph-devtools"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./styles.css": "./build/styles.css"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "test:package-contract": "node ../../tests/package-contract/run.mjs graph-devtools",
    "prepublishOnly": "pnpm run typecheck",
    "test:unit": "jest --passWithNoTests",
    "test": "pnpm run test:unit"
  },
  "peerDependencies": {
    "@gravity-ui/graph": "workspace:^"
  },
  "devDependencies": {
    "@gravity-ui/eslint-config": "^3.2.0",
    "@swc/core": "^1.13.3",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "5.39.0",
    "@typescript-eslint/parser": "5.39.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-import-resolver-typescript": "2.5.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.0.5",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.0.5",
    "prettier": "^3.0.0",
    "typescript": "catalog:"
  }
}
