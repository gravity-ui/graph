{
  "compilerOptions": {
    "outDir": "./build/",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2020",
    "noEmitOnError": false,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": [
      "es2020",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "@playwright/test",
      "node"
    ],
    "strict": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "*.ts",
    "page-objects/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
