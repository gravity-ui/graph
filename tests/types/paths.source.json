{
  // Resolve the public packages to their TypeScript sources.
  // React (including subpaths such as react/jsx-runtime) and signals are pinned to graph-react's
  // copies so every project sees one instance, independently of node_modules in parent directories.
  "compilerOptions": {
    "paths": {
      "react": ["../../packages/graph-react/node_modules/@types/react/index.d.ts"],
      "react/*": ["../../packages/graph-react/node_modules/@types/react/*"],
      "react-dom/*": ["../../packages/graph-react/node_modules/@types/react-dom/*"],
      "@preact/signals-core": ["../../packages/graph-react/node_modules/@preact/signals-core"],
      "@gravity-ui/graph": ["../../packages/graph/src/index.ts"],
      "@gravity-ui/graph-react": ["../../packages/graph-react/src/index.ts"],
      "@gravity-ui/graph-minimap": ["../../packages/graph-minimap/src/index.ts"],
      "@gravity-ui/graph-devtools": ["../../packages/graph-devtools/src/index.ts"],
      "@gravity-ui/graph-css-variables": ["../../packages/graph-css-variables/src/index.ts"]
    }
  }
}
